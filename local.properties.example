# Copia este archivo como `local.properties` y ajusta la ruta del SDK de Android.
# En Windows las barras invertidas se escapan con doble barra invertida o se usan barras normales.
#
# Windows:
# sdk.dir=C\:\\Users\\TU_USUARIO\\AppData\\Local\\Android\\Sdk
#
# macOS:
# sdk.dir=/Users/TU_USUARIO/Library/Android/sdk
#
# Linux:
# sdk.dir=/home/TU_USUARIO/Android/Sdk
